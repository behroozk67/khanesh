#!/bin/sh
# Khanesh / LabMate — pre-commit gate
#
# بک‌اند: npm test (رگرسیون موتور قوانین)  |  فرانت‌اند: npm run lint
# فقط برای زیرپروژه‌ای اجرا می‌شود که فایلی از آن stage شده باشد.
#
# ⚠️ بررسی‌ها روی **ایندکس** اجرا می‌شوند، نه درختِ کاری.
#    نسخهٔ قبلی این هوک `cd "$ROOT/$dir"` می‌زد، یعنی هرچه روی دیسک بود را تست
#    می‌کرد. نتیجه‌اش acc9cc0 است: هوک ۱۹۳/۱۹۳/۰ چاپ کرد و کامیت ۱۹۳/۱۸۱/۱۲
#    بود، با M38 قرمز روی یک نقصِ واقعیِ متنِ انگلیسی در patterns_hematology.js.
#    ایندکس و درختِ کاری دو چیزند؛ گِیت باید آن یکی را بسنجد که کامیت می‌شود.
#    (CLAUDE.md → N15(b))
#
# رد کردن موقت:  SKIP_HOOKS=1 git commit ...

set -u

if [ "${SKIP_HOOKS:-0}" = "1" ]; then
  echo "pre-commit: skipped (SKIP_HOOKS=1)"
  exit 0
fi

ROOT=$(git rev-parse --show-toplevel)

# ⚠️ D عمداً در فیلتر هست. با ACMR، کامیتی که فقط فایل حذف می‌کند فهرستِ خالی
# می‌داد و هوک بی‌صدا exit 0 می‌شد — یعنی حذفِ یک فایلِ زندهٔ rules/، که
# بیشترین نیاز را به گِیت دارد، تنها تغییری بود که اصلاً گِیت نمی‌خورد.
STAGED=$(git diff --cached --name-only --diff-filter=ACMRD)

[ -z "$STAGED" ] && exit 0

NEED_BACKEND=0
NEED_FRONTEND=0
echo "$STAGED" | grep -q '^khanesh-server/.*\.\(js\|mjs\|json\)$' && NEED_BACKEND=1
echo "$STAGED" | grep -q '^khanesh/.*\.\(js\|jsx\|mjs\|json\)$' && NEED_FRONTEND=1

if [ "$NEED_BACKEND" = 0 ] && [ "$NEED_FRONTEND" = 0 ]; then
  exit 0
fi

DIRS=""
[ "$NEED_BACKEND" = 1 ] && DIRS="$DIRS khanesh-server"
[ "$NEED_FRONTEND" = 1 ] && DIRS="$DIRS khanesh"

# ── ساختِ درختِ ایندکس در یک پوشهٔ موقت ────────────────────────────────────
#
# چرا آرشیو و نه `git stash -k`: stash درختِ کاریِ کاربر را جابه‌جا می‌کند، و
# اگر تست کرش کند یا کاربر Ctrl-C بزند، کارِ کامیت‌نشده داخل یک stash entry
# می‌ماند و درختِ کاری شبیهِ ایندکس می‌شود — یعنی هوک کارِ کاربر را «ناپدید»
# کرده. اینجا هیچ‌چیزِ درختِ کاری لمس نمی‌شود؛ بدترین حالتِ شکست یک پوشهٔ
# جامانده در TMPDIR است، نه کارِ گم‌شده.
#
# node_modules و .env هر دو gitignore شده‌اند، پس در آرشیو نیستند:
#   • node_modules را لینک می‌کنیم — بدونش api-contract.test.js نمی‌تواند
#     express را import کند، کلِ فایل می‌ترکد و T1..T10 قرمز می‌شوند؛ یعنی
#     هوک هر کامیتی را با یک شکستِ جعلی می‌بست. (CLAUDE.md → Commands)
#   • .env را عمداً لینک نمی‌کنیم: کامیت نشده، پس تست هم نباید به آن تکیه کند.
#     اندازه‌گیری شد — نبودنش هیچ تستی را قرمز نمی‌کند.

WORKDIR=""

is_windows() {
  case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) return 0 ;; *) return 1 ;; esac
}

# ── لینکِ پوشه: روی ویندوز junction اول، ln -s فقط پشتیبان ───────────────────
#
# ln -s در Git Bash فقط وقتی لینکِ واقعی می‌سازد که MSYS=winsymlinks:nativestrict
# ست باشد یا Developer Mode روشن باشد؛ وگرنه بسته به شرایط شکست می‌خورد. این
# فرضی نیست: پنج اجرای پشت‌سرهم روی همین مخزن، دو موفق و سه شکست داد. هر شکست
# یعنی تنزل به درختِ کاری، و یک کامیتِ گِیت‌نخورده — 8aaba5d دقیقاً همین بود.
# junction هیچ‌کدام از آن شرط‌ها را نمی‌خواهد و برای پوشه قطعی است.
# ⚠️ ساختن و برداشتنِ junction در ویندوز با node انجام می‌شود، نه cmd — و این
#    اندازه‌گیری است نه ترجیح. دو شکستِ پشت‌سرهم روی همین محیط:
#      ۱. «cmd //c ...» اجرا نمی‌شد: «//» از تبدیلِ مسیرِ MSYS عبور می‌کند و به
#         cmd می‌رسد به‌عنوانِ یک مسیرِ UNC، پس /c هرگز داده نمی‌شود؛ cmd واردِ
#         حالتِ تعاملی می‌شود، از stdinِ بسته بیرون می‌آید و صفر برمی‌گرداند —
#         یعنی لینک ساخته نمی‌شد، «ls -A» خالی بود و هر کامیتِ فرانت‌اند با
#         «ساختِ درختِ ایندکس ممکن نشد» رد می‌شد (گِیتِ سالم ولی همیشه قرمز).
#      ۲. node هم مسیرِ posix را نمی‌گیرد: MSYS آرگومانِ «/tmp/...» را برای
#         برنامهٔ native به «C:\tmp\...» می‌برد، در حالی که خودِ bash همان مسیر
#         را «C:\Users\...\AppData\Local\Temp» می‌داند. یعنی لینک جایی ساخته
#         می‌شد که bash اصلاً نگاه نمی‌کند. راه‌حل همان cygpath -w است که نسخهٔ
#         cmdی هوک هم می‌فرستاد.
#    گِیت ضعیف نمی‌شود: اگر لینک ساخته نشود prepare_index_tree همچنان ۱
#    برمی‌گرداند و کامیت بسته می‌شود. با node هر دو طرف یک سازوکارند:
#    symlinkSync می‌سازد و rmdirSync در cleanup فقط لینک را برمی‌دارد — همان
#    چیزی که این تابع می‌خواست و rm -rf تضمینش نمی‌کند.
link_dir() {
  _target=$1; _link=$2
  if is_windows; then
    node -e 'const fs=require("fs");fs.symlinkSync(process.argv[2],process.argv[1],"junction")' \
      "$(cygpath -w "$_link")" "$(cygpath -w "$_target")" 2>/dev/null && return 0
  fi
  ln -s "$_target" "$_link" 2>/dev/null
}

cleanup() {
  [ -n "$WORKDIR" ] || return 0
  [ -d "$WORKDIR" ] || return 0

  # ⚠️ junction را صریح باز کن، پیش از rm -rf.
  # این محافظه‌کاری تزئینی نیست: اگر rm -rf روی junction آن را *دنبال* کند،
  # node_modulesِ واقعیِ پروژه پاک می‌شود و هوک از گِیت تبدیل می‌شود به تخریب.
  # رمزگشا: rmdir روی junction فقط لینک را برمی‌دارد نه هدف را — و node
  # (همان سازوکارِ ساختنِ لینک بالا) همین تضمین را می‌دهد؛ «cmd //c rmdir» اینجا
  # مثلِ «cmd //c mklink» اجرا نمی‌شد و لینک سرِ جایش می‌ماند.
  for _d in $DIRS; do
    _nm="$WORKDIR/$_d/node_modules"
    [ -e "$_nm" ] || continue
    if is_windows; then
      node -e 'const fs=require("fs");try{fs.rmdirSync(process.argv[1])}catch(e){process.exit(1)}' \
        "$(cygpath -w "$_nm")" 2>/dev/null
    fi
    [ -e "$_nm" ] && rm -f "$_nm" 2>/dev/null
    # اگر لینک باقی ماند، rm -rf را انجام نمی‌دهیم: یک پوشهٔ جامانده در TMPDIR
    # بهتر از node_modulesِ واقعیِ پاک‌شده است. (این تازه از زمانی معنا دارد که
    # لینک واقعاً ساخته می‌شود — یعنی همین اصلاح.)
    if [ -e "$_nm" ]; then
      printf '\033[33mpre-commit: لینکِ node_modules برداشته نشد؛ پوشهٔ موقت نگه داشته می‌شود: %s\033[0m\n' "$WORKDIR"
      return 0
    fi
  done

  rm -rf "$WORKDIR"
  return 0
}
trap cleanup EXIT INT TERM

prepare_index_tree() {
  # write-tree و `git diff --cached` بالا هر دو از یک ایندکس می‌خوانند — هرکدام که
  # گیت به هوک داده باشد (در صورتِ ست‌بودنِ GIT_INDEX_FILE، همان). پس «کدام بررسی
  # اجرا شود» و «چه محتوایی سنجیده شود» نمی‌توانند از هم واگرا شوند؛ واگراییِ همین
  # دو، خودِ نقصی بود که این بازنویسی برای رفعش است.
  # اگر ایندکس merge نشده باشد (وسطِ conflict) شکست می‌خورد و به مسیرِ تنزل می‌رود.
  tree=$(git write-tree 2>/dev/null) || return 1
  [ -n "$tree" ] || return 1

  WORKDIR=$(mktemp -d 2>/dev/null) || return 1

  for d in $DIRS; do
    git archive "$tree" "$d" 2>/dev/null | tar -x -C "$WORKDIR" || return 1
    [ -d "$WORKDIR/$d" ] || return 1

    if [ -d "$ROOT/$d/node_modules" ]; then
      link_dir "$ROOT/$d/node_modules" "$WORKDIR/$d/node_modules" || return 1
      # لینک باید واقعاً قابل‌عبور باشد، نه فقط موجود. «ساخته شد» و «کار می‌کند»
      # دو چیزند؛ خواندنِ محتوا تنها اثباتِ قابل‌قبول است.
      [ -n "$(ls -A "$WORKDIR/$d/node_modules" 2>/dev/null)" ] || return 1
    fi
  done

  return 0
}

# ⚠️ این انتساب کلِ هوک است. اگر جا بیفتد، BASE روی درختِ کاری می‌ماند و هوک
# همان کارِ قبلی را می‌کند ولی برچسبِ «ایندکس» چاپ می‌کند — یعنی نقصِ اصلی،
# این‌بار با یک ادعای دروغ رویش. در نسخهٔ اولِ همین بازنویسی دقیقاً همین شد.
if prepare_index_tree; then
  BASE="$WORKDIR"
else
  # ⚠️ اینجا **کامیت بسته می‌شود**، و این تغییرِ عمدیِ نسخهٔ قبل است.
  #
  # قبلاً به درختِ کاری تنزل می‌کرد، با این استدلال که «هوکی که به‌خاطرِ نقصِ
  # خودش همه را رد کند بدتر است». آن استدلال غلط از آب درآمد: تنزل روی ویندوز
  # نادر نبود، *اکثریت* بود (سه از پنج)، و چون درختِ کاری معمولاً سبزتر از
  # ایندکس است، نتیجه یک گِیتِ تصادفی شد — همان کامیت، یک‌بار بسته و یک‌بار باز.
  # گِیتِ تصادفی از نبودِ گِیت بدتر است، چون اعتماد می‌سازد بی‌آنکه ضمانتی بدهد.
  # 8aaba5d با ۱۱ تستِ قرمز از همین در رد شد.
  #
  # حالا شکستِ ساختِ درخت یعنی «نمی‌دانم»، و «نمی‌دانم» جوابش رد است نه قبول.
  # هرکس واقعاً بخواهد عبور کند SKIP_HOOKS=1 را دارد — که صریح است و در
  # خروجی دیده می‌شود، برخلافِ تنزلی که خودش را پشتِ یک بنر پنهان می‌کرد.
  printf '\n\033[31m✘ pre-commit: ساختِ درختِ ایندکس ممکن نشد.\033[0m\n'
  printf '  بدونِ آن، تنها چیزی که می‌شد سنجید درختِ کاری است — و آن دربارهٔ\n'
  printf '  خودِ کامیت هیچ نمی‌گوید. پس کامیت بسته شد، نه اینکه بی‌ضمانت رد شود.\n'
  printf '  اگر آگاهانه می‌خواهی رد شوی:  SKIP_HOOKS=1 git commit ...\n\n'
  exit 1
fi

printf '\n\033[36mpre-commit: بررسی روی ایندکس\033[0m\n'

FAILED=""

run_check() {
  # run_check <label> <dir> <command...>
  label=$1; dir=$2; shift 2
  printf '\n\033[36m▶ %s\033[0m  (%s)\n' "$label" "$*"
  if ( cd "$BASE/$dir" && "$@" ); then
    printf '\033[32m✔ %s\033[0m\n' "$label"
  else
    printf '\033[31m✘ %s\033[0m\n' "$label"
    FAILED="$FAILED\n  - $label"
  fi
}

if [ "$NEED_BACKEND" = 1 ]; then
  run_check "backend tests" "khanesh-server" npm test --silent
fi

if [ "$NEED_FRONTEND" = 1 ]; then
  run_check "frontend lint" "khanesh" npm run lint --silent
fi

if [ -n "$FAILED" ]; then
  printf '\n\033[31mcommit blocked:\033[0m%b\n' "$FAILED"
  printf 'اصلاح کن و دوباره commit بزن — یا با SKIP_HOOKS=1 رد کن.\n\n'
  exit 1
fi

exit 0
