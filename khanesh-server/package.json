{
  "name": "lab-proxy",
  "version": "1.0.0",
  "description": "سرور واسط امن برای اپلیکیشن تفسیر آزمایش با آوال‌ای",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=85"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "rules"
    ],
    "ext": "js,json",
    "ignore": [
      "rules/*.test.js"
    ],
    "delay": "300"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
