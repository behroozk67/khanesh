{
  "name": "lab-proxy",
  "version": "1.0.0",
  "description": "سرور واسط امن برای اپلیکیشن تفسیر آزمایش با آوال‌ای",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=85",
    "promptfoo:fixtures": "node promptfoo/generate-fixtures.mjs",
    "promptfoo:eval": "promptfoo eval -c promptfoo/promptfooconfig.yaml",
    "promptfoo:view": "promptfoo view"
  },
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "rules"
    ],
    "ext": "js,json",
    "ignore": [
      "rules/*.test.js",
      "*.test.js"
    ],
    "delay": "300"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.3.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "nodemon": "^3.1.10",
    "promptfoo": "^0.123.0"
  }
}
