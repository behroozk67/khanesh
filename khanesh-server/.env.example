# پیکربندی نمونه سرور آزمایار اپ (مقادیر فرضی)
PORT=8787
NODE_ENV=development
TRUST_PROXY=1

# ارتباط با ارائه‌دهنده هوش مصنوعی
AVALAI_API_KEY=your_avalai_api_key_here
AVALAI_BASE_URL=https://api.avalai.ir/v1
TEXT_MODEL=gpt-4o-mini
VISION_MODEL=gemini-2.5-flash

# احراز هویت و توکن‌ها
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars
AUTH_REQUIRED=false

# سامانه پیامکی SMS.ir جهت ارسال کد ورود (اختیاری در لوکال)
SMSIR_API_KEY=your_sms_ir_key
SMSIR_TEMPLATE_ID=your_template_id
SMSIR_PARAM=CODE

# درگاه پرداخت زرین‌پال
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=false
SITE_ORIGIN=https://azmayarapp.ir

# اعلان‌های پشتیبانی فرم تماس (اختیاری)
TELEGRAM_NOTIFY_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_NOTIFY_CHAT_ID=your_telegram_chat_id
TELEGRAM_API_BASE=https://api.telegram.org
NOTIFY_EMAIL=admin@example.com
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# فقط این شماره‌ها حتی با REQUIRE_PAYMENT=false پرداخت واقعی می‌کنند (تست درگاه روی production)
PAYMENT_TEST_PHONES=

# هدیهٔ ثبت‌نام: این تعداد تفسیرِ رایگان با همهٔ امکانات، فقط یک ماهِ اول و فقط حسابِ موبایلی (ثبت‌نام‌های بعد از استقرار). ریست ماهانه ندارد. خالی ⇒ ۲، ۰ ⇒ خاموش
FREE_SIGNUP_CREDITS=2
# ⚠️ نمکِ هشِ دفترِ هدیه. production بدونِ آن بوت نمی‌شود. یک بار بساز (openssl rand -hex 32)، پشتیبان بگیر و هرگز عوضش نکن؛
# عوض‌شدنش یعنی حذف + ثبت‌نامِ دوباره دوباره هدیه می‌دهد.
FREE_LEDGER_SALT=
# سقفِ کلِ هدیه‌های ثبت‌نامِ تازه در هر ۲۴ ساعت (بدترین هزینهٔ روزانه را محدود می‌کند)
FREE_SIGNUP_DAILY_MAX=200

# هر چند میلی‌ثانیه پرداخت‌های تأییدنشدهٔ زرین‌پال بررسی شوند (فقط production؛ ۰ = خاموش). پیش‌فرض ۵ دقیقه.
RECONCILE_MS=300000
