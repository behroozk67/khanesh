[
  {
    "id": "normal_cbc_raw_counts",
    "why": "N3 — Iranian sheets print WBC/PLT as raw counts, not K/µL. A normal CBC must stay normal.",
    "expect": { "urgency": "none", "no_patterns": ["unmatched_abnormal"], "abnormal_keys_empty": true },
    "ocr": {
      "patient": { "age": 34, "sex": "M" },
      "tests": [
        { "name": "WBC", "value": "7000", "unit": "/µL" },
        { "name": "RBC", "value": "5.1", "unit": "M/µL" },
        { "name": "Hgb", "value": "15.2", "unit": "g/dL" },
        { "name": "HCT", "value": "45", "unit": "%" },
        { "name": "MCV", "value": "88", "unit": "fL" },
        { "name": "Platelet", "value": "250000", "unit": "/µL" }
      ]
    }
  },
  {
    "id": "iron_deficiency_anemia",
    "why": "N1 — a covered multi-test pattern must be matched by a rule, never fall through to unmatched_abnormal.",
    "expect": { "min_findings": 1, "no_patterns": ["unmatched_abnormal"] },
    "ocr": {
      "patient": { "age": 29, "sex": "F" },
      "tests": [
        { "name": "Hgb", "value": "9.4", "unit": "g/dL" },
        { "name": "MCV", "value": "68", "unit": "fL" },
        { "name": "Ferritin", "value": "5", "unit": "ng/mL" },
        { "name": "Iron", "value": "22", "unit": "µg/dL" },
        { "name": "TIBC", "value": "460", "unit": "µg/dL" }
      ]
    }
  },
  {
    "id": "critical_hypokalemia",
    "why": "N12 — severity and direction are two axes. A critically LOW potassium must never be described as high.",
    "expect": { "urgency_at_least": "this_week", "dir_of": { "K": "low" }, "forbid_text": ["هایپرکالمی"] },
    "ocr": {
