      "tests": [
        { "name": "Potassium", "value": "2.4", "unit": "mEq/L" },
        { "name": "Sodium", "value": "138", "unit": "mEq/L" },
        { "name": "Creatinine", "value": "0.9", "unit": "mg/dL" }
      ]
    }
  },
  {
    "id": "hba1c_ifcc_units",
    "why": "N3 — 48 mmol/mol is exactly the ADA diabetes threshold (6.5%); graded as a percentage it reads as 'normal'.",
    "expect": { "conversion_for": "HBA1C", "min_findings": 1 },
    "ocr": {
      "patient": { "age": 52, "sex": "M" },
      "tests": [
        { "name": "HbA1c", "value": "48", "unit": "mmol/mol" },
        { "name": "FBS", "value": "131", "unit": "mg/dL" }
      ]
    }
  },
  {
    "id": "geriatric_borderline_hb",
    "why": "N13 — the engine's age-adjusted verdict is authoritative; a borderline geriatric Hb must not be forced abnormal.",
    "expect": { "graded_present": ["HGB"] },
    "ocr": {
      "patient": { "age": 78, "sex": "M" },
      "tests": [
        { "name": "Hemoglobin", "value": "12.3", "unit": "g/dL" },
        { "name": "MCV", "value": "90", "unit": "fL" }
      ]
    }
  },
  {
    "id": "reactive_serology_screen",
