/*.png
.playwright-mcp/

labmat-prototype/node_modules/

# خروجی اجراهای eval-gate (شواهد و evaluation.json هر اجرا) — قابل بازتولید، commit نمی‌شود
.claude/eval-gate/runs/

# دیتابیس محلیِ SQLite. اجرای `npm test` خودش می‌سازدش (server.js هنگام
# import، initDb() را صدا می‌زند)، پس بدون این خط هر بار یک باینریِ ۲۴ کیلوبایتی
# در git status ظاهر می‌شود و دیر یا زود commit می‌گردد — همراهِ هر شماره‌تلفنی
# که در جدولِ users نشسته. مسیر لنگر انداخته، طبق درسِ N14.
/khanesh-server/database.sqlite
/khanesh-server/database.sqlite-journal
/khanesh-server/database.sqlite-wal
/khanesh-server/database.sqlite-shm

# ── راز‌ها ──
# labmat-prototype/.env با کلیدِ زندهٔ AvalAI داخلِ مخزن بود؛ از index بیرون
# کشیده شد (فایلِ محلیِ کاری سرِ جایش می‌ماند). کلید باید در پنلِ AvalAI لغو/
# بچرخد — تاریخچهٔ گیت هنوز آن را دارد. قاعدهٔ bare تا هیچ .envی دوباره
# track نشود؛ کلیدِ واقعی همیشه از متغیرِ محیطی/.envِ محلی می‌آید.
.env
.env.*

# ردیابیِ درخواست‌ها (trace.js با TRACE_DISK=1 مقادیرِ بالینیِ بیمار اینجا
# می‌نویسد — وعدهٔ کامنتِ خودِ trace.js که تا امروز در gitignore نبود)
/khanesh-server/.traces/

# خروجیِ اجراهای promptfoo — قابل بازتولید (npm run promptfoo:eval)، commit نمی‌شود.
